% ----- TABLE DES MATIéRES -----

\newcommand{\MyTableOfContents}{%
	\clearpage
	\pagenumbering{Roman}
	
	\phantomsection
	\pdfbookmark[0]{Sommaire}{toc}
	
	\setcounter{tocdepth}{2}
	
	\begin{center}
		{\Large \bfseries Table des matières}
	\end{center}
	
	\vspace{1cm}
	
	\tableofcontents
	
	\newpage
	\pagenumbering{arabic}
}


\newcommand{\MyBibliography}{%
	\clearpage
	
	% --- Pagination B1, B2 ...
	\pagenumbering{arabic} % A partir de B1
	\renewcommand{\thepage}{B\arabic{page}}
	\setcounter{page}{1}
	
	% --- Ajouter à Table des matières
	
	\phantomsection
	\addcontentsline{toc}{section}{Références}
	\pdfbookmark[0]{Références}{bibliography}
	
	% --- Titre
	\begin{center}
		{\LARGE \bfseries Références}
	\end{center}
	\vspace{1cm}
	
	% --- Bibliographie
	\printbibliography
	
	\newpage
}